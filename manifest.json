{
  "manifest_version": 3,
  "name": "ManaBox ➔ Archidekt Deck Sync",
  "version": "1.0.0",
  "description": "Compare and sync Magic: The Gathering deck changes from ManaBox directly to Archidekt.",
  "action": {},
  "background": {
    "service_worker": "service-worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "cookies",
    "tabs"
  ],
  "host_permissions": [
    "https://archidekt.com/*",
    "https://manabox.app/*",
    "https://*.scryfall.io/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
